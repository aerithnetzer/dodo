FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /workspace

# Copy shared package first
COPY packages/shared /workspace/packages/shared

# Copy service files
COPY services/dodo-activity-api/pyproject.toml ./
COPY services/dodo-activity-api/uv.lock* ./

# Create virtual environment and install shared package first, then sync
RUN uv venv && uv pip install -e /workspace/packages/shared && uv sync --no-install-project

# Copy the rest of the service code
COPY services/dodo-activity-api/ ./

# Now install the project itself
RUN uv sync

EXPOSE 8000

CMD ["uv", "run", "fastapi", "dev", "./main.py"]
